# ==============================================================================
# BIZFLOW AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and fill in your actual Azure AI Foundry credentials.
# DO NOT commit .env.local to version control.

# --- Azure AI Foundry Agent Service Configuration ---
# Project Endpoint format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://simranjit-bizflow-ai103-260921.services.ai.azure.com/api/projects/bizflow-multi-agent

# Azure AI Foundry API Key (if authenticating via Key)
AZURE_AI_FOUNDRY_API_KEY=your_azure_foundry_api_key_here

# Existing Agent Name in Azure AI Foundry Agent Service
AZURE_AI_FOUNDRY_AGENT_NAME=ManagerOrchestrator

# (Optional) Azure Entra ID Service Principal Authentication (Alternative to API Key)
# AZURE_TENANT_ID=your_tenant_id_here
# AZURE_CLIENT_ID=your_client_id_here
# AZURE_CLIENT_SECRET=your_client_secret_here

# --- Application Configuration ---
# Set to 'false' to connect directly to the real live Azure AI Foundry ManagerOrchestrator.
# Set to 'true' only if you want temporary UI simulation without calling Azure.
DEMO_MODE=false
